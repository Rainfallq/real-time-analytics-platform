# Copy to .env and change the values. Never commit .env.
ENVIRONMENT=development
DEBUG=true
# SQL_ECHO prints every SQL statement. Keep it false during load tests.
SQL_ECHO=false
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://rtap_user:change_me@localhost:5432/analytics
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0
# outbox = variant B (scoring in the worker), sync = variant A (scoring in the request)
INGEST_MODE=outbox
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_RAW_DATA=raw-data
KAFKA_TOPIC_DLQ=raw-data.dlq
